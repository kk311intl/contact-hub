{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "your-contact-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "vars": { "ADMIN_LANGUAGE": "en" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/admin", "/api/*"]
  },
  "kv_namespaces": [
    { "binding": "PROFILE_KV", "id": "YOUR_KV_NAMESPACE_ID" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "VISITOR_COUNTER", "class_name": "VisitorCounter" }]
  },
  "migrations": [{ "tag": "visitor-counter-v1", "new_sqlite_classes": ["VisitorCounter"] }]
}
